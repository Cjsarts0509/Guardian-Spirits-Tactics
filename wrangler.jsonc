// 화면(클라이언트) 배포 — Cloudflare Workers 정적 자산. 이름은 대시보드에서 만든 Worker 이름과 같아야 한다.
// 빌드: pnpm --filter @gst/client build (빌드 변수 VITE_SERVER_URL=wss://ws.<도메인>)
{
  "name": "gst-client",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/client/dist",
    "not_found_handling": "single-page-application"
  }
}
