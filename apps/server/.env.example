# 게임 서버 환경변수 (apps/server/.env 로 복사해서 사용)
PORT=8787
# 0.0.0.0 = IP 로 직접 접속. Cloudflare Tunnel 을 쓸 때는 127.0.0.1
HOST=0.0.0.0

# 개발 편의: 게스트 닉네임 입장 / 봇 채우기
ALLOW_GUESTS=true
ALLOW_BOTS=true

# 화면(클라이언트 빌드) 폴더. 설정하면 이 서버가 화면도 같이 준다 (운영: /opt/gst/public)
# STATIC_DIR=../client/dist

# WebSocket Origin. 같은 주소는 항상 허용. 화면을 다른 곳에 둘 때만 목록에 추가 (쉼표 구분)
# ALLOWED_ORIGINS=https://play.example.xyz
# true 면 같은 주소 + 목록만 허용 (운영). false 이고 목록이 비면 전부 허용 (개발)
STRICT_ORIGIN=false

RECONNECT_GRACE_SECONDS=60
TICK_MS=250
# 게임 시계 배속 (개발·테스트용). 운영은 반드시 1
TIME_SCALE=1
BOT_ACTIVITY=0.012
# 연결 유지 ping 주기(ms). Cloudflare 는 100초 무응답 WebSocket 을 끊는다
HEARTBEAT_MS=30000

# Supabase (설정하면 로그인 토큰 검증 + 판 기록 저장)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_JWT_SECRET=             # JWKS 대신 레거시 HS256 시크릿을 쓸 때만
# SUPABASE_SECRET_KEY=             # sb_secret_… (Project Settings → API Keys). 서버 전용, 절대 클라이언트/깃에 넣지 말 것
#                                  # 레거시 service_role 키는 SUPABASE_SERVICE_ROLE_KEY 로도 받는다
